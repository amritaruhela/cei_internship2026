# Application
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://datatrust:datatrust_pass@localhost:5432/datatrust
POSTGRES_USER=datatrust
POSTGRES_PASSWORD=datatrust_pass
POSTGRES_DB=datatrust

# Backend
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
API_V1_STR=/api/v1
PROJECT_NAME=DataTrust

# Data Engine
DATA_DIR=./data
RAW_DIR=./data/raw
BRONZE_DIR=./data/bronze
SILVER_DIR=./data/silver
GOLD_DIR=./data/gold
GENERATED_DIR=./data/generated
SPARK_LOCAL_MODE=true
SPARK_MASTER=local[*]

# Monitoring
DEFAULT_TRUST_SCORE_WEIGHTS_COMPLETENESS=0.20
DEFAULT_TRUST_SCORE_WEIGHTS_CONSISTENCY=0.25
DEFAULT_TRUST_SCORE_WEIGHTS_ACCURACY=0.20
DEFAULT_TRUST_SCORE_WEIGHTS_FRESHNESS=0.15
DEFAULT_TRUST_SCORE_WEIGHTS_UNIQUENESS=0.10
DEFAULT_TRUST_SCORE_WEIGHTS_DRIFT=0.10

# Alerting (local dev - no external provider needed)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=your@email.com
ALERT_EMAIL_PASSWORD=your-email-password

# Databricks (for production deployment only)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=
DELTA_CATALOG=main
DELTA_SCHEMA=datatrust

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
